-- تشغيل برمجة: LocalScript
task.spawn(function()
	local script = setmetatable({Parent = ui_ToggleBtn_8, Name = "LocalScript"}, {__index = ui_ToggleBtn_8})
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local Workspace = game:GetService("Workspace")
	local VirtualInputManager = game:GetService("VirtualInputManager")
	
	local player = Players.LocalPlayer
	local button = script.Parent
	local frame = button.Parent
	
	-- الإعدادات القابلة للتعديل
	local TWEEN_SPEED = 6 -- سرعة الحركة في الكستم توين
	local HITBOX_TARGET_SIZE = Vector3.new(250, 250, 250) -- حجم ضخم يغطي من الوسط لأطراف الجزيرة
	local ATTACK_COOLDOWN = 0.25 -- الفاصل الزمني بين الضربات
	local ATTRIBUTE_NAME = "melee"
	
	-- حفظ اللون الأصلي للفريم
	local originalFrameColor = frame.BackgroundColor3
	local GREEN_COLOR = Color3.fromRGB(46, 204, 113)
	
	-- حالة التشغيل والهدف الحالي
	local isActive = false
	local currentTargetModel = nil
	local lastAttackTime = 0
	local connections = {}
	
	-- دالة للحصول على مجسم اللاعب و RootPart
	local function getCharacterParts()
		local char = player.Character
		if not char then return nil, nil end
		local hrp = char:FindFirstChild("HumanoidRootPart")
		local hum = char:FindFirstChildOfClass("Humanoid")
		if not hrp or not hum or hum.Health <= 0 then return nil, nil end
		return char, hrp
	end
	
	-- دالة للحصول على مركز RaidIsland1 داخل RaidMap
	local function getIslandCenterCFrame()
		local raidMap = Workspace:FindFirstChild("RaidMap")
		if not raidMap then return nil end
	
		local island = raidMap:FindFirstChild("RaidIsland1", true)
		if not island then return nil end
	
		if island:IsA("BasePart") then
			return island.CFrame * CFrame.new(0, island.Size.Y * 0.5 + 3, 0)
		elseif island:IsA("Model") then
			local pivot = island:GetPivot()
			local _, size = island:GetBoundingBox()
			return pivot * CFrame.new(0, size.Y * 0.5 + 3, 0)
		end
		return nil
	end
	
	-- دالة Custom Tween للحركة بدون TweenService
	local function customStepMoveTo(hrp, targetCFrame, dt)
		local currentPos = hrp.Position
		local targetPos = targetCFrame.Position
		local delta = targetPos - currentPos
		local distance = delta.Magnitude
	
		if distance > 0.1 then
			local step = math.min(distance, TWEEN_SPEED * dt)
			local nextPos = currentPos + delta.Unit * step
			hrp.CFrame = CFrame.lookAt(nextPos, Vector3.new(targetPos.X, nextPos.Y, targetPos.Z))
		end
	end
	
	-- دالة لتكبير Hitbox العدو والتحقق من حجمه فعلياً
	local function expandAndVerifyHitbox(enemyModel)
		if not enemyModel or not enemyModel.Parent then return false end
	
		local hitbox = enemyModel:FindFirstChild("Hitbox", true)
		if not hitbox or not hitbox:IsA("BasePart") then
			-- إذا لم يوجد جزء باسم Hitbox، نستخدم HumanoidRootPart أو PrimaryPart كبديل
			hitbox = enemyModel:FindFirstChild("HumanoidRootPart") or enemyModel.PrimaryPart
		end
	
		if not hitbox or not hitbox:IsA("BasePart") then
			return false
		end
	
		-- جعل الجزء غير معيق للحركة
		hitbox.Anchored = false
		hitbox.CanCollide = false
		hitbox.Massless = true
		hitbox.Size = HITBOX_TARGET_SIZE
	
		-- التحقق من أن الحجم أصبح كبيراً فعلياً (أكبر من 100 في كل محور)
		local verified = (hitbox.Size.X >= 100) and (hitbox.Size.Y >= 100) and (hitbox.Size.Z >= 100)
		return verified
	end
	
	-- دالة للبحث عن أداة في الشنطة تحتوي على Attribute "melee" وتجهيزها
	local function equipMeleeTool()
		local char = player.Character
		local backpack = player:FindFirstChild("Backpack")
		if not char or not backpack then return nil end
	
		-- تحقق إذا كانت أداة melee مجهزة بالفعل في اليد
		local equippedTool = char:FindFirstChildOfClass("Tool")
		if equippedTool and equippedTool:GetAttribute(ATTRIBUTE_NAME) ~= nil then
			return equippedTool
		end
	
		-- البحث داخل Backpack
		for _, item in ipairs(backpack:GetChildren()) do
			if item:IsA("Tool") and item:GetAttribute(ATTRIBUTE_NAME) ~= nil then
				local hum = char:FindFirstChildOfClass("Humanoid")
				if hum then
					hum:EquipTool(item)
					return item
				end
			end
		end
	
		return nil
	end
	
	-- دالة لتنفيذ الضغط على الشاشة وتفعيل أداة القتال
	local function triggerClickAttack(tool)
		local now = os.clock()
		if now - lastAttackTime < ATTACK_COOLDOWN then return end
		lastAttackTime = now
	
		-- محاكاة ضغطة ماوس/شاشة
		pcall(function()
			VirtualInputManager:SendMouseButtonEvent(500, 500, 0, true, game, 0)
			task.wait(0.03)
			VirtualInputManager:SendMouseButtonEvent(500, 500, 0, false, game, 0)
		end)
	
		-- تفعيل الأداة مباشرة لضمان الضرب
		if tool and tool.Parent == player.Character then
			pcall(function()
				tool:Activate()
			end)
		end
	end
	
	-- دالة لتفريغ الاتصالات عند الإيقاف
	local function clearConnections()
		for _, conn in ipairs(connections) do
			if conn and conn.Connected then
				conn:Disconnect()
			end
		end
		table.clear(connections)
	end
	
	-- دالة إيقاف كل شيء وإعادة لون الفريم
	local function stopSystem()
		isActive = false
		currentTargetModel = nil
		frame.BackgroundColor3 = originalFrameColor
		clearConnections()
	end
	
	-- دالة تشغيل النظام ومراقبة RaidMap و Enemies
	local function startSystem()
		isActive = true
		frame.BackgroundColor3 = GREEN_COLOR
		clearConnections()
	
		local raidMap = Workspace:FindFirstChild("RaidMap")
		local enemiesFolder = Workspace:FindFirstChild("Enemies")
	
		-- مراقبة ظهور موديل جديد في RaidMap للذهاب إليه بالتوين
		if raidMap then
			local raidAddedConn = raidMap.DescendantAdded:Connect(function(descendant)
				if not isActive then return end
				if descendant:IsA("Model") then
					currentTargetModel = descendant
				elseif descendant:IsA("BasePart") and descendant.Parent == raidMap then
					currentTargetModel = descendant
				end
			end)
			table.insert(connections, raidAddedConn)
		end
	
		-- مراقبة أي عدو جديد يرسبن في Enemies لتكبير الـ Hitbox والتحقق منه
		if enemiesFolder then
			local enemyAddedConn = enemiesFolder.DescendantAdded:Connect(function(descendant)
				if not isActive then return end
				local targetEnemy = descendant:IsA("Model") and descendant or descendant:FindFirstAncestorOfClass("Model")
				if targetEnemy and targetEnemy:IsDescendantOf(enemiesFolder) then
					task.defer(function()
						if isActive then
							expandAndVerifyHitbox(targetEnemy)
						end
					end)
				end
			end)
			table.insert(connections, enemyAddedConn)
	
			-- فحص الأعداء الموجودين حالياً أيضاً
			for _, enemy in ipairs(enemiesFolder:GetChildren()) do
				if enemy:IsA("Model") then
					expandAndVerifyHitbox(enemy)
				end
			end
		end
	
		-- الحلقة الرئيسية للحركة (Custom Tween) والهجوم
		local heartbeatConn = RunService.Heartbeat:Connect(function(dt)
			if not isActive then return end
	
			local char, hrp = getCharacterParts()
			if not char or not hrp then return end
	
			local desiredCFrame = nil
	
			-- إذا رسبن موديل جديد في RaidMap نتحرك نحوه بالتوين؛ وإلا نبقى في وسط RaidIsland1
			if currentTargetModel and currentTargetModel.Parent then
				if currentTargetModel:IsA("Model") then
					desiredCFrame = currentTargetModel:GetPivot() * CFrame.new(0, 0, 4)
				elseif currentTargetModel:IsA("BasePart") then
					desiredCFrame = currentTargetModel.CFrame * CFrame.new(0, 3, 0)
				end
			else
				currentTargetModel = nil
				desiredCFrame = getIslandCenterCFrame()
			end
	
			if desiredCFrame then
				customStepMoveTo(hrp, desiredCFrame, dt)
			end
	
			-- التأكد من حجم Hitbox للأعداء الموجودين في Enemies
			if enemiesFolder then
				for _, enemy in ipairs(enemiesFolder:GetChildren()) do
					if enemy:IsA("Model") then
						local hum = enemy:FindFirstChildOfClass("Humanoid")
						if not hum or hum.Health > 0 then
							expandAndVerifyHitbox(enemy)
						end
					end
				end
			end
	
			-- تجهيز أداة melee من الشنطة والضغط للضرب
			local meleeTool = equipMeleeTool()
			if meleeTool then
				triggerClickAttack(meleeTool)
			end
		end)
	
		table.insert(connections, heartbeatConn)
	end
	
	-- ربط الضغط على الزر للتشغيل أو الإيقاف
	button.MouseButton1Click:Connect(function()
		if isActive then
			stopSystem()
		else
			startSystem()
		end
	end)
end)

