	local isEnabled = false
	local connections = {}
	local originalHitboxes = {} -- [BasePart] = {Size = Vector3, CanCollide = boolean, Transparency = number}
	local centerCFrame = nil
	
	local function clearConnections()
		for _, conn in ipairs(connections) do
			if conn.Connected then
				conn:Disconnect()
			end
		end
		table.clear(connections)
	end
	
