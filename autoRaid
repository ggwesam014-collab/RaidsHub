		local raidMap = workspace:FindFirstChild(CONFIG.RaidMapName)
		if not raidMap then return nil end
	
		local island = raidMap:FindFirstChild(CONFIG.IslandName)
		if not island then return nil end
	
		if island:IsA("Model") then
			local cf, size = island:GetBoundingBox()
			-- رفع اللاعب قليلًا فوق منتصف الجزيرة حتى لا يعلق بالأرض
			return CFrame.new(cf.Position + Vector3.new(0, math.max(size.Y * 0.5 + 3, 5), 0))
		elseif island:IsA("BasePart") then
			return CFrame.new(island.Position + Vector3.new(0, island.Size.Y * 0.5 + 3, 0))
		end
	
		return nil
	end
	
	-- Custom Tween بدون الاعتماد على TweenService الخاص بـ CFrame فقط (حركة ملساء مخصصة عبر RunService)
	local function customTweenToCenter(targetCF, duration)
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if not root or not targetCF then return end
	
		local startCF = root.CFrame
		local elapsed = 0
	
		while elapsed < duration and isEnabled do
			character = player.Character
			root = character and character:FindFirstChild("HumanoidRootPart")
			if not root then break end
	
			local dt = RunService.RenderStepped:Wait()
			elapsed += dt
			local alpha = math.clamp(elapsed / duration, 0, 1)
			-- EaseInOut مخصص
			local smoothAlpha = alpha < 0.5 and (4 * alpha * alpha * alpha) or (1 - ((-2 * alpha + 2) ^ 3) / 2)
			root.CFrame = startCF:Lerp(targetCF, smoothAlpha)
		end
	
		if isEnabled and root then
			root.CFrame = targetCF
		end
	end
	
	local function isMeleeTool(tool)
		if not tool or not tool:IsA("Tool") then
			return false
		end
	
		-- الحالة 1: وجود Attribute اسمه "melee" بقيمة true
		local attrByName = tool:GetAttribute(CONFIG.AttributeName)
		if attrByName == true or attrByName == "melee" then
			return true
		end
	
		-- الحالة 2: وجود أي Attribute قيمته تساوي "melee"
		for _, val in pairs(tool:GetAttributes()) do
			if val == "melee" then
				return true
			end
		end
	
		return false
	end
	
	local function equipMeleeTool()
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local backpack = player:FindFirstChildOfClass("Backpack")
		if not character or not humanoid or not backpack then return nil end
	
		-- إذا كانت الأداة مجهزة مسبقًا في الشخصية
		for _, item in ipairs(character:GetChildren()) do
			if isMeleeTool(item) then
				return item
			end
		end
	
		-- البحث في الشنطة (Backpack) وتجهيزها
		for _, item in ipairs(backpack:GetChildren()) do
			if isMeleeTool(item) then
				humanoid:EquipTool(item)
				return item
			end
		end
	
		return nil
	end
	
	local function findHitboxPart(enemyModel)
		if not enemyModel or not enemyModel:IsA("Model") then
			return nil
		end
	
		-- البحث عن جزء باسم Hitbox أو مشابه، وإلا استخدام HumanoidRootPart أو PrimaryPart
		local directHitbox = enemyModel:FindFirstChild("Hitbox", true)
		if directHitbox and directHitbox:IsA("BasePart") then
			return directHitbox
		end
	
		for _, desc in ipairs(enemyModel:GetDescendants()) do
			if desc:IsA("BasePart") and string.find(string.lower(desc.Name), "hitbox") then
				return desc
			end
		end
	
		return enemyModel:FindFirstChild("HumanoidRootPart") or enemyModel.PrimaryPart
	end
	
	local function expandEnemyHitbox(enemyModel)
		if not isEnabled or not enemyModel then return end
	
		local hitbox = findHitboxPart(enemyModel)
		if not hitbox then return end
	
		-- حفظ الحجم الأصلي مرة واحدة فقط لإرجاعه عند الإيقاف
		if not originalHitboxes[hitbox] then
			originalHitboxes[hitbox] = {
				Size = hitbox.Size,
				CanCollide = hitbox.CanCollide,
				Transparency = hitbox.Transparency,
				Massless = hitbox.Massless,
			}
		end
	
		-- تكبير الحجم ثم التحقق الفعلي من الحجم
		hitbox.Massless = true
		hitbox.CanCollide = false
		hitbox.Size = CONFIG.HitboxTargetSize
	
		-- التحقق من أن الحجم أصبح كبيرًا بالفعل (مع مراعاة قيود المحرك إن وُجدت)
		if hitbox.Size.Magnitude < CONFIG.HitboxTargetSize.Magnitude * 0.5 then
			hitbox.Size = Vector3.new(
				math.max(hitbox.Size.X, 150),
				math.max(hitbox.Size.Y, 80),
				math.max(hitbox.Size.Z, 150)
			)
		end
	end
	
	local function restoreAllHitboxes()
		for part, data in pairs(originalHitboxes) do
			if part and part.Parent then
				part.Size = data.Size
				part.CanCollide = data.CanCollide
				part.Transparency = data.Transparency
				part.Massless = data.Massless
			end
		end
		table.clear(originalHitboxes)
	end
	
	local function simulateScreenClick(tool)
		-- تفعيل الأداة مباشرة إن أمكن
		if tool and tool.Parent == player.Character then
			pcall(function()
				tool:Activate()
			end)
		end
	
		-- محاكاة ضغط زر الفأرة في منتصف الشاشة
		local camera = workspace.CurrentCamera
		local viewportSize = camera and camera.ViewportSize or Vector2.new(1280, 720)
		local x = viewportSize.X * 0.5
		local y = viewportSize.Y * 0.5
	
		pcall(function()
			VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
			task.wait(0.03)
			VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
		end)
	end
	
	local function setFrameColor(active)
		if not frame or not frame:IsA("GuiObject") then return end
		local targetColor = active and CONFIG.ActiveColor or originalColor
		TweenService:Create(frame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			BackgroundColor3 = targetColor
		}):Play()
	end
	
	local function startSystem()
		if isEnabled then return end
		isEnabled = true
		setFrameColor(true)
	
		centerCFrame = getIslandCenterCFrame()
		if centerCFrame then
			task.spawn(function()
				customTweenToCenter(centerCFrame, CONFIG.TweenDuration)
			end)
		end
	
		-- مراقبة الأعداء الحاليين والذين يرسبنون لاحقًا في Enemies
		local enemiesFolder = workspace:FindFirstChild(CONFIG.EnemiesFolderName)
		if enemiesFolder then
			for _, child in ipairs(enemiesFolder:GetChildren()) do
				task.spawn(expandEnemyHitbox, child)
			end
	
			table.insert(connections, enemiesFolder.ChildAdded:Connect(function(child)
				task.wait(0.05)
				expandEnemyHitbox(child)
			end))
		end
	
		-- حلقة التثبيت في الوسط + تجهيز أداة melee + الضرب المستمر
		task.spawn(function()
			while isEnabled do
				centerCFrame = centerCFrame or getIslandCenterCFrame()
				local character = player.Character
				local root = character and character:FindFirstChild("HumanoidRootPart")
	
				-- إبقاء اللاعب في وسط الجزيرة بعد انتهاء التوين الأولي
				if root and centerCFrame and (root.Position - centerCFrame.Position).Magnitude > 2 then
					root.CFrame = centerCFrame
				end
	
				-- التأكد من حجم Hitbox لكل الأعداء الموجودين
				local currentEnemies = workspace:FindFirstChild(CONFIG.EnemiesFolderName)
				if currentEnemies then
					for _, enemy in ipairs(currentEnemies:GetChildren()) do
						expandEnemyHitbox(enemy)
					end
				end
	
				-- تجهيز أداة تحمل attribute melee والضرب
				local equippedTool = equipMeleeTool()
				simulateScreenClick(equippedTool)
	
				task.wait(CONFIG.AttackInterval)
			end
		end)
	end
	
	local function stopSystem()
		if not isEnabled then return end
		isEnabled = false
		setFrameColor(false)
		clearConnections()
		restoreAllHitboxes()
	end
	
	button.MouseButton1Click:Connect(function()
		if isEnabled then
			stopSystem()
		else
			startSystem()
		end
	end)
	
	player.CharacterAdded:Connect(function()
		if isEnabled then
			task.wait(0.5)
			centerCFrame = getIslandCenterCFrame()
			if centerCFrame then
				customTweenToCenter(centerCFrame, CONFIG.TweenDuration)
			end
		end
	end)
end)

